+static void check_common_presence(common_sampler * sampler, llama_token token, float expected) {
+    llama_sampler * chain = common_sampler_get(sampler);
+    for (int i = 0; i < llama_sampler_chain_n(chain); ++i) {
+        llama_sampler * penalty = llama_sampler_chain_get(chain, i);
+        if (std::string(llama_sampler_name(penalty)) != "penalties") {
+            continue;
+        }
+        llama_token_data value = { token, 2.0f, 0.0f };
+        llama_token_data_array values = { &value, 1, -1, false };
+        llama_sampler_apply(penalty, &values);
+        GGML_ASSERT(fabsf(value.logit - expected) < 1e-6f);
+        return;
+    }
+    GGML_ABORT("presence penalty sampler missing");
+}
