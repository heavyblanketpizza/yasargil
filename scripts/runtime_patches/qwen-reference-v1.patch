+static void test_generated_history(const char * model_path) {
+    auto model_params = llama_model_default_params();
+    model_params.vocab_only = true;
+    model_params.n_gpu_layers = 0;
+    llama_model * model = llama_model_load_from_file(model_path, model_params);
+    GGML_ASSERT(model != nullptr);
+    GGML_ASSERT(llama_vocab_n_tokens(llama_model_get_vocab(model)) >= 3);
+
+    for (bool generated_only : { false, true }) {
+        common_params_sampling params;
+        GGML_ASSERT(!params.samplers_generated_only);
+        params.samplers_generated_only = generated_only;
+        params.penalty_last_n = 128;
+        params.penalty_present = 1.5f;
+        params.samplers = { COMMON_SAMPLER_TYPE_PENALTIES };
+        common_sampler * sampler = common_sampler_init(model, params);
+
+        common_sampler_accept(sampler, 0, false);
+        GGML_ASSERT(common_sampler_last(sampler) == 0);
+        check_common_presence(sampler, 0, generated_only ? 2.0f : 0.5f);
+
+        common_sampler_accept(sampler, 1, true);
+        for (int i = 0; i < 96; ++i) {
+            common_sampler_accept(sampler, 2, true);
+        }
+        check_common_presence(sampler, 1, 0.5f);
+
+        common_sampler * cloned = common_sampler_clone(sampler);
+        common_sampler * copied = common_sampler_init(model, params);
+        common_sampler_copy(sampler, copied);
+        common_sampler_reset(sampler);
+        check_common_presence(sampler, 1, 2.0f);
+        for (common_sampler * saved : { cloned, copied }) {
+            check_common_presence(saved, 1, 0.5f);
+            common_sampler_accept(saved, 0, false);
+            check_common_presence(saved, 0, generated_only ? 2.0f : 0.5f);
+            common_sampler_free(saved);
+        }
+        common_sampler_accept(sampler, 0, false);
+        check_common_presence(sampler, 0, generated_only ? 2.0f : 0.5f);
+        common_sampler_free(sampler);
+    }
+    llama_model_free(model);
+    printf("generated-only sampler history: passed\n");
 }
 
